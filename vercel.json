{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/.well-known/openid-configuration",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/auth",
      "destination": "/api/oidc/auth"
    },
    {
      "source": "/token",
      "destination": "/api/oidc/token"
    },
    {
      "source": "/me",
      "destination": "/api/oidc/me"
    },
    {
      "source": "/jwks",
      "destination": "/api/oidc/jwks"
    },
    {
      "source": "/reg",
      "destination": "/api/oidc/reg"
    },
    {
      "source": "/device",
      "destination": "/api/oidc/device"
    },
    {
      "source": "/session/:path*",
      "destination": "/api/oidc/session/:path*"
    },
    {
      "source": "/interaction/:path*",
      "destination": "/api/oidc/interaction/:path*"
    },
    {
      "source": "/token/:path*",
      "destination": "/api/oidc/token/:path*"
    },
    {
      "source": "/request/:path*",
      "destination": "/api/oidc/request/:path*"
    },
    {
      "source": "/connect/:path*",
      "destination": "/api/oidc/connect/:path*"
    },
    {
      "source": "/health/live",
      "destination": "/api/oidc/health/live"
    },
    {
      "source": "/health/ready",
      "destination": "/api/oidc/health/ready"
    },
    {
      "source": "/login",
      "destination": "/api/oidc/login"
    },
    {
      "source": "/login/:path*",
      "destination": "/api/oidc/login/:path*"
    },
    {
      "source": "/register",
      "destination": "/api/oidc/register"
    },
    {
      "source": "/forgot-password",
      "destination": "/api/oidc/forgot-password"
    },
    {
      "source": "/reset-password",
      "destination": "/api/oidc/reset-password"
    },
    {
      "source": "/verify-email",
      "destination": "/api/oidc/verify-email"
    },
    {
      "source": "/logout",
      "destination": "/api/oidc/logout"
    },
    {
      "source": "/mfa",
      "destination": "/api/oidc/login/mfa"
    },
    {
      "source": "/account/unfreeze",
      "destination": "/api/oidc/account/unfreeze"
    },
    {
      "source": "/privacy",
      "destination": "/api/oidc/privacy"
    },
    {
      "source": "/terms",
      "destination": "/api/oidc/terms"
    },
    {
      "source": "/account",
      "destination": "/account.html"
    },
    {
      "source": "/account/profile",
      "destination": "/account.html"
    },
    {
      "source": "/account/security",
      "destination": "/account.html"
    },
    {
      "source": "/account/devices",
      "destination": "/account.html"
    },
    {
      "source": "/account/danger",
      "destination": "/account.html"
    },
    {
      "source": "/account/services",
      "destination": "/account.html"
    },
    {
      "source": "/services",
      "destination": "/services.html"
    },
    {
      "source": "/cookie-policy",
      "destination": "/cookie-policy.html"
    }
  ]
}
