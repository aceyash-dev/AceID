{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/forgot-password", "destination": "/forgot-password.html" },
    { "source": "/reset-password", "destination": "/reset-password.html" },
    { "source": "/mfa", "destination": "/mfa.html" },
    { "source": "/account", "destination": "/account.html" },
    { "source": "/consent", "destination": "/consent.html" },
    { "source": "/services", "destination": "/services.html" },
    { "source": "/subscription", "destination": "/subscription.html" },
    { "source": "/cookie-policy", "destination": "/cookie-policy.html" }
  ]
}
